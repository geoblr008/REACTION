# Copy this file to .env and fill in your key
PORT=4000

# --- AI provider ---
# "anthropic" (default, cloud) or "ollama" (fully local, free)
AI_PROVIDER=ollama

# Used only when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your_api_key_here

# Used only when AI_PROVIDER=ollama
# Install from https://ollama.com, then: ollama pull llama3.1
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
